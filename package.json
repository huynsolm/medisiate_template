{
  "name": "cms-medisay-migration",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "css-check": "tsx apps/cli/src/cli.ts css-check",
    "inventory": "tsx apps/cli/src/cli.ts inventory",
    "convert": "tsx apps/cli/src/cli.ts convert",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p apps/cli && tsc --noEmit -p apps/web && tsc --noEmit -p .",
    "web": "npm run dev -w @cms-medisay/web",
    "web:build": "npm run build -w @cms-medisay/web",
    "test:browser": "node scripts/test-browser.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.39.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.9"
  }
}
