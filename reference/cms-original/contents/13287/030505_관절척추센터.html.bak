        <section class="cms type01">
            <div class="cms-inner">
                <!-- 제목 영역 [s] -->
                <div class="cms-header">
                    <p class="cms-thin-title"><em>정형외과와 신경외과간의 유기적인 협진<br></em>KS병원의 관절척추센터</p>
                </div>
                <!-- 제목 영역 [e] -->
                <!-- 콘텐츠 영역 [s] -->
