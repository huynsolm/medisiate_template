	.cms-container .cms .cms-tile-list.text-type-1 .cms-description-box .cms-title {margin-bottom:0;}
	.cms-container .cms.type-bg.bg-image-2 {background:url(https://fxfile.drline.net/local/13267/cms/sub_0205_img_bg.jpg) no-repeat 50% 50%;}
	.cms-container .cms .cms-bullet-list.list-bg-box .cms-list-item:before {display:none;}
	.cms-container .cms .cms-bullet-list.list-bg-box .cms-list-item .top-area {border-bottom:1px solid #63656c;padding-bottom:5%}
	.cms-container .cms .cms-tile-list .cms-description-box .cms-description {text-align:left;}
	.cms-container .cms .cms-figure-list.text-type-1 .cms-figure-text .cms-description {font-size:22px;}
	@media (max-width:991px){
		.cms-container .cms .cms-description-box .cms-description .description {font-size:0.938rem;}
		.cms-container .cms .cms-column-list.text-type-3 .cms-list-item .cms-description span {display:block;line-height:1.5rem;}
	}
	@media (max-width:479px){
		.cms-container .cms .cms-description-box .cms-description .description {font-size:0.75rem;}
		.cms-container .cms .cms-column-list.text-type-3 .cms-list-item .cms-description span {display:block;line-height:1rem;}
		.cms-container .cms .cms-figure-list.text-type-1 .cms-figure-text .cms-description {font-size:16px;}
	}
	@media (min-width: 992px){
		.cms-container .cms .cms-tile-list.array-zigzag:not(.reverse) .cms-list-item.row {
			-webkit-box-orient: horizontal;
			-webkit-box-direction: reverse;
			-ms-flex-direction: row-reverse;
			flex-direction: row-reverse;
		}
		.cms-container .cms .cms-tile-list .cms-description-box .cms-eyebrow {display:inline-block;vertical-align:middle;;}
		.cms-container .cms .cms-tile-list.text-type-1 .cms-description-box .cms-title {display:inline-block;vertical-align:top;padding:0;}
		.cms-container .cms .cms-tile-list .cms-description-box .cms-box-inner {text-align:left;}
	}

	.box-iframe{ padding-top: 56.25%;position: relative;}
	.box-iframe iframe{position:absolute;top:0;left:0;width:100%;height:100%;z-index:100;pointer-events:auto}
